# FlowForge environment (copy to .env — never commit .env)

# Data directory (SQLite DB, APK cache)
FLOWFORGE_DATA_DIR=./data

# Static assets and legal page templates
FLOWFORGE_STATIC_DIR=./assets/static
FLOWFORGE_TEMPLATES_DIR=./assets/templates

# IANA timezone for scheduling
FLOWFORGE_TZ=America/New_York

# Public URL users reach in browser / OAuth redirect (required in production when FLOWFORGE_REQUIRE_SECRETS=1)
FLOWFORGE_PUBLIC_URL=https://flowforge.example.com

# App version shown in /api/app and mobile update checks
FLOWFORGE_APP_VERSION=3.0.9
FLOWFORGE_VERSION_CODE=30009

# Scheduler placement engine: go (default, always available) or rust (requires flowforge-solver binary)
FLOWFORGE_SCHEDULER_ENGINE=go
# FLOWFORGE_SOLVER_BIN=/app/flowforge-solver

# If no APK is baked into the image / data volume, fetch FlowForge.apk from this GitHub repo's latest release
FLOWFORGE_APK_GITHUB_REPO=eklier101/flowforge

# Google Calendar OAuth (optional — leave empty to disable Google sync)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: seed first admin on startup (otherwise use /api/auth/bootstrap)
# FLOWFORGE_ADMIN_USER=admin
# FLOWFORGE_ADMIN_PASSWORD=

# Container listen port (host maps 8098:8000 in docker-compose.yml)
FLOWFORGE_PORT=8000

# Set to 1 in production to fail startup when FLOWFORGE_PUBLIC_URL is missing
# FLOWFORGE_REQUIRE_SECRETS=1
